FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# STEP 1 — System deps
RUN apt-get update && apt-get install -y curl wget gnupg2 software-properties-common ca-certificates apt-transport-https build-essential

# STEP 2 — Add ALL PPAs first (before any python symlink)
RUN add-apt-repository -y ppa:deadsnakes/ppa && \
    add-apt-repository -y ppa:ondrej/php && \
    apt-get update

# STEP 3 — Install ALL apt packages in one layer
RUN apt-get install -y \
    python3.12 \
    gcc-12 g++-12 \
    openjdk-21-jdk \
    php8.3-cli

# STEP 4 — NOW create symlinks (after all PPAs done)
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    ln -sf /usr/bin/gcc-12 /usr/bin/gcc && \
    ln -sf /usr/bin/g++-12 /usr/bin/g++ && \
    ln -sf /usr/bin/php8.3 /usr/bin/php

# STEP 5 — Node.js 20 via nodesource
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g tsx typescript @types/node

# STEP 6 — MongoDB 
RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | \
    gpg --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg && \
    echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" > /etc/apt/sources.list.d/mongodb-org-7.0.list && \
    apt-get update && apt-get install -y mongodb-mongosh

# STEP 7 — Go 1.22
RUN wget https://go.dev/dl/go1.22.0.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.22.0.linux-amd64.tar.gz && \
    rm go1.22.0.linux-amd64.tar.gz && \
    ln -sf /usr/local/go/bin/go /usr/bin/go

# STEP 8 — Rust 1.77 (CRITICAL: Copy ACTUAL binary & open permissions for libs)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.77.0 --no-modify-path && \
    cp /root/.rustup/toolchains/1.77.0-x86_64-unknown-linux-gnu/bin/rustc /usr/local/bin/rustc && \
    chmod 755 /root && \
    chmod -R 755 /root/.rustup

ENV LD_LIBRARY_PATH=/root/.rustup/toolchains/1.77.0-x86_64-unknown-linux-gnu/lib:$LD_LIBRARY_PATH

# STEP 8.5 — Ruby 3.3 via rbenv (Custom Source Build)
RUN apt-get install -y \
    git libssl-dev libreadline-dev zlib1g-dev \
    autoconf bison libyaml-dev libncurses5-dev \
    libffi-dev libgdbm-dev && \
    curl -fsSL https://github.com/rbenv/rbenv-installer/raw/HEAD/bin/rbenv-installer | bash && \
    export PATH="/root/.rbenv/bin:/root/.rbenv/shims:$PATH" && \
    rbenv install 3.3.0 && \
    rbenv global 3.3.0 && \
    ln -sf /root/.rbenv/shims/ruby /usr/local/bin/ruby

ENV PATH="/root/.rbenv/bin:/root/.rbenv/shims:$PATH"

# STEP 9 — .NET 9 SDK
RUN wget https://dot.net/v1/dotnet-install.sh && \
    bash dotnet-install.sh --version 9.0.100 --install-dir /usr/share/dotnet && \
    ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet

# Pre-create C# template in /opt to avoid runtime /tmp tmpfs wipe
RUN mkdir -p /opt/cs-template && \
    cd /opt/cs-template && \
    dotnet new console -n App && \
    cd App && dotnet restore && \
    chmod -R 777 /opt/cs-template

# STEP 10 — Cleanup
RUN apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /root/.cargo

# Set ENV vars
ENV GOPATH=/tmp/go
ENV GOCACHE=/tmp/.cache
ENV GOFLAGS=-mod=mod
ENV DOTNET_CLI_HOME=/tmp
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
ENV DOTNET_NOLOGO=1
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV COMPlus_EnableDiagnostics=0

# STEP 11 — sandbox user, entrypoint, WORKDIR
RUN useradd -m -u 1000 -s /bin/bash sandbox
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /sandbox
USER sandbox
ENTRYPOINT ["/entrypoint.sh"]
