# Number of pre-warmed runner containers to keep active per language
# SHARED VPS: Keep low (3) to limit idle resource consumption
POOL_SIZE_PER_LANG=3

# Maximum execution time in seconds for interpreted languages (e.g. Python, Node)
EXECUTION_TIMEOUT_INTERPRETED=15

# Maximum execution time in seconds for compiled languages (e.g. C++, Go)
EXECUTION_TIMEOUT_COMPILED=30

# Memory limit for each runner container
MAX_RAM_PER_CONTAINER=256m

# CPU quota for each runner container (0.5 = half a core)
MAX_CPU_PER_CONTAINER=0.5

# Internal Redis connection string
REDIS_URL=redis://redis:6379

# API binding host (0.0.0.0 to allow access from other containers)
API_HOST=0.0.0.0

# API internal port
API_PORT=8000

# Change to your VPS IP or domain (e.g. runly.dev) when deploying
# Variable interpolation is NOT supported in .env files - set values directly
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_API_URL=http://localhost/api

# NVIDIA NIM API for AI Tutor chatbot
# !!! ROTATE THIS KEY IF REPO WAS EVER PUBLIC !!!
NVIDIA_API_KEY=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
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Max chat requests per IP per day (NVIDIA free tier limit)
CHAT_RATE_LIMIT_PER_DAY=40

# Expiration for temporary database sessions (1 hour)
SESSION_TTL=3600

# --- Security & Scaling (added by QA fixes) ---

# CORS allowed origins. Comma-separated. Empty = allow all (dev mode).
# Set to your domain in production, e.g.: https://runly.dev,https://www.runly.dev
ALLOWED_ORIGINS=

# WebSocket origin validation. Same format as ALLOWED_ORIGINS.
ALLOWED_WS_ORIGINS=

# Max code execution requests per IP per minute
MAX_WS_RATE_PER_MIN=30

# Max code payload size in bytes (50KB)
MAX_CODE_SIZE=50000

# Max on-the-fly containers when pool is empty (per language)
# SHARED VPS: Keep low to prevent resource stampede
MAX_ON_THE_FLY=2

